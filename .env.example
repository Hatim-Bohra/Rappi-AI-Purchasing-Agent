# ==========================================
# Rappi AI Purchasing Agent Environment Configuration
# ==========================================

# Port configuration (optional, default: 3000)
PORT=3000

# LLM Provider Configuration
# Mode options: "gemini" | "openai" | "anthropic" | "mock"
# Default is "mock" which allows running the entire multi-scenario ReAct agent,
# validation feedback loop, and evaluation suite 100% offline with zero API keys!
LLM_PROVIDER=mock

# Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Model Name override (optional)
# Gemini: gemini-1.5-pro, gemini-1.5-flash
# OpenAI: gpt-4o, gpt-4o-mini
# Anthropic: claude-3-5-sonnet-20241022
LLM_MODEL=

# Agent Execution Safety Limits
AGENT_MAX_ITERATIONS=10
AUTO_APPROVE_MAX_BUDGET_USD=5000
REQUIRE_HITL_ON_STOCKOUT_RISK=true
